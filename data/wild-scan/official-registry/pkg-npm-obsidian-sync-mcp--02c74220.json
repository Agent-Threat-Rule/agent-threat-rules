      "name": "io.github.es617/obsidian-sync-mcp",
      "description": "Give AI agents access to your Obsidian vault via local files or Self-hosted LiveSync.",
      "repository": {
        "url": "https://github.com/es617/obsidian-sync-mcp.git",
