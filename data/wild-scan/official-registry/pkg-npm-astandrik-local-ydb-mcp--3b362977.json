          "identifier": "@astandrik/local-ydb-mcp",
          "version": "0.14.0",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "runtimeArguments": [
            {
              "type": "named",
              "name": "-y"
            },
            {
              "type": "named",
              "name": "--prefer-online"
            }
          ],
          "environmentVariables": [
            {
              "description": "Optional path to a local-ydb-toolkit config JSON file.",
