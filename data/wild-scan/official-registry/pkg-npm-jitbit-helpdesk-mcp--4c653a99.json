    "server": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.github.jitbit/jitbit-helpdesk",
      "description": "MCP server for Jitbit Helpdesk: search, list, read, and reply to support tickets from AI assistants.",
      "title": "Jitbit Helpdesk",
      "repository": {
        "url": "https://github.com/jitbit/jitbit-helpdesk-mcp",
        "source": "github"
      },
      "version": "2.0.0",
      "packages": [
        {
          "registryType": "npm",
          "identifier": "jitbit-helpdesk-mcp",
          "version": "2.0.0",
          "transport": {
            "type": "stdio"
          },
          "environmentVariables": [
            {
              "description": "Base URL of your Jitbit Helpdesk instance",
              "isRequired": true,
              "format": "string",
              "name": "JITBIT_URL"
            },
            {
              "description": "API token from your Jitbit user profile",
              "isRequired": true,
              "format": "string",
              "isSecret": true,
              "name": "JITBIT_TOKEN"
            }
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://{helpdesk_host}/api/mcp",
          "headers": [
            {
              "description": "Bearer API token from your Jitbit user profile, for example Bearer your-api-token",
              "isRequired": true,
              "isSecret": true,
              "name": "Authorization"
            }
          ],
          "variables": {
            "helpdesk_host": {
              "description": "Your Jitbit Helpdesk hostname, for example yourcompany.jitbit.com or helpdesk.example.com",
              "isRequired": true
            }
          }
        }
      ]
    },
