      "name": "io.github.Anirudhx7/suitecrm-mcp",
      "description": "Open-source MCP gateway for SuiteCRM - 24 CRM tools, OAuth2/OIDC auth, multi-entity, observability.",
      "repository": {
        "url": "https://github.com/Anirudhx7/suitecrm-mcp",
        "source": "github"
      },
      "version": "5.5.0",
      "websiteUrl": "https://anirudh.social/suitecrm-mcp/",
      "packages": [
        {
          "registryType": "npm",
          "identifier": "suitecrm-mcp-gateway",
          "version": "5.5.0",
          "transport": {
            "type": "sse",
            "url": "http://127.0.0.1:{PORT}/sse",
            "headers": [
              {
                "description": "Bearer token - personal API key issued by the gateway after OAuth2/OIDC login",
                "isRequired": true,
                "isSecret": true,
                "name": "Authorization"
              }
            ]
          },
          "environmentVariables": [
            {
              "description": "SuiteCRM v4_1 REST endpoint URL, e.g. https://crm.example.com/service/v4_1/rest.php",
              "isRequired": true,
              "format": "string",
              "name": "SUITECRM_ENDPOINT"
            },
            {
              "description": "Tool name prefix, e.g. suitecrm",
              "isRequired": true,
              "format": "string",
              "name": "SUITECRM_PREFIX"
            },
            {
              "description": "Port the gateway listens on",
              "isRequired": true,
              "format": "number",
              "name": "PORT"
            },
            {
              "description": "OIDC provider domain, e.g. your-tenant.auth0.com",
              "isRequired": true,
              "format": "string",
              "name": "AUTH0_DOMAIN"
            },
            {
              "description": "OAuth2 API audience identifier",
              "isRequired": true,
              "format": "string",
              "name": "AUTH0_AUDIENCE"
            }
          ]
        }
      ]
    },
