    {
      "server": {
        "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
        "name": "io.github.Sidd27/infrawise",
        "description": "Static infrastructure analysis via MCP: databases, AWS services, IaC, and code patterns.",
        "repository": {
          "url": "https://github.com/Sidd27/infrawise",
          "source": "github"
        },
        "version": "0.5.0",
        "packages": [
          {
            "registryType": "npm",
            "identifier": "infrawise",
            "version": "0.5.0",
            "transport": {
              "type": "streamable-http",
              "url": "http://localhost:3000/mcp"
            },
            "environmentVariables": [
              {
                "description": "AWS region to analyze (e.g. us-east-1)",
                "format": "string",
                "name": "AWS_REGION"
              },
              {
                "description": "AWS access key (or use a named profile in infrawise.yaml)",
                "format": "string",
                "isSecret": true,
                "name": "AWS_ACCESS_KEY_ID"
              },
              {
                "description": "AWS secret key (or use a named profile in infrawise.yaml)",
                "format": "string",
                "isSecret": true,
                "name": "AWS_SECRET_ACCESS_KEY"
              }
            ]
          }
        ]
      },
