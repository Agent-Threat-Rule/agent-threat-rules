    "server": {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "com.somdewan/timezone-helper",
      "description": "MCP server for TimezoneDB.",
      "title": "Timezone Helper",
      "version": "5.0.0",
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://tz-{region}.somdewan.com/mcp",
          "headers": [
            {
              "description": "Your TimezoneDB API key (free at https://timezonedb.com/register).",
              "isRequired": true,
              "isSecret": true,
              "name": "X-TimezoneDB-Key"
            },
            {
              "description": "Optional override of the default https://api.timezonedb.com host (e.g. for a self-hosted mirror).",
              "name": "X-Backend-URL"
            }
          ],
          "variables": {
            "region": {
              "description": "Choose the regional endpoint to connect to. EU users typically prefer `eu` to keep request data within the EU; US users prefer `us` for lower latency.",
              "isRequired": true,
              "choices": [
                "us",
                "eu"
              ]
            }
          }
        }
      ]
    },
