  "tools": [
    {
      "name": "kv_namespaces_list",
      "description": "\n\t\t\tList all of the kv namespaces in your Cloudflare account.\n\t\t\tUse this tool when you need to list all of the kv namespaces in your Cloudflare account.\n\t\t\tReturns a list of kv namespaces with the following properties:\n\t\t\t- id: The id of the kv namespace.\n\t\t\t- title: The title of the kv namespace.\n\t\t\t",
      "inputSchema": {
        "type": "object",
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ],
                "description": "Direction to order namespaces (asc/desc)"
              },
              "order": {
                "type": "string",
                "enum": [
                  "id",
                  "title"
                ],
                "description": "Field to order namespaces by (id/title)"
              },
              "page": {
                "type": "integer",
                "description": "Page number of results (starts at 1)"
              },
              "per_page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Number of namespaces per page (1-100)"
              }
            },
            "additionalProperties": false,
            "description": "Optional parameters for listing KV namespaces"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "title": "List KV namespaces",
        "readOnlyHint": true
      }
    },
