{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/fetch-npm-version.mjs && node scripts/fetch-contributors.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fetch-npm-version.mjs && node scripts/fetch-contributors.mjs",
    "build": "next build && next-sitemap",
    "deploy": "node scripts/fetch-npm-version.mjs && node scripts/fetch-contributors.mjs && next build && next-sitemap && wrangler pages deploy out --project-name=agentthreatrule --commit-dirty=true",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "fuse.js": "^7.3.0",
    "geist": "^1.3.1",
    "js-yaml": "^4.1.1",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "next-sitemap": "^4.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
